{
  "expo": {
    "name": "iMeet",
    "slug": "imeet",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "imeet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.imeet.app"
    },
    "android": {
      "package": "com.imeet.app"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
